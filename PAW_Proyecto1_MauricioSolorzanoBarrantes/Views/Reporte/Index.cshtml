
@model IEnumerable<PAW_Proyecto1_MauricioSolorzanoBarrantes.Models.ReporteEstado>

@{
    ViewBag.Title = "Reporte de tickets";
    int totalTickets = Model.Sum(r => r.Cantidad);
}

<main class="container">

    <section class="mt-4">

        <header class="mb-4">
            <h2>Reporte de tickets por estado</h2>

            <p class="text-muted">
                Consulta la cantidad de tickets registrados según su estado actual.
            </p>
        </header>

        <!-- Total de tickets -->
        <div class="card shadow-sm mb-4">

            <div class="card-body text-center">

                <h5 class="text-muted">Total de tickets registrados</h5>

                <h2 class="fw-bold text-primary">
                    @totalTickets
                </h2>

            </div>

        </div>

        <!-- Reporte por estado -->
        <div class="card shadow-sm">

            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Cantidad de tickets por estado</h5>
            </div>

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle mb-0">

                        <thead class="table-dark">
                            <tr>
                                <th>Estado</th>
                                <th class="text-center">Cantidad de tickets</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var estado in Model)
                            {
                                <tr>
                                    <td>@estado.NombreEstado</td>

                                    <td class="text-center">
                                        <span class="badge bg-primary fs-6">
                                            @estado.Cantidad
                                        </span>
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <div class="mt-3">

            @Html.ActionLink(
                     "Volver al inicio",
                     "Index",
                     "Home",
                     null,
                     new { @class = "btn btn-outline-secondary" }
                 )

        </div>

    </section>

</main>
