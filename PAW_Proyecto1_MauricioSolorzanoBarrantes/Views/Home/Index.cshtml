
@{
    ViewBag.Title = "Inicio";

    bool estaAutenticado = Request.IsAuthenticated &&
                           Session["UsuarioRol"] != null;

    string rol = estaAutenticado
        ? Session["UsuarioRol"].ToString()
        : "";
}

<main class="container">

    <section class="mt-5 mb-5">

        <header class="text-center mb-5">

            <h1 class="display-5 fw-bold">
                Sistema Help Desk
            </h1>

            <p class="lead text-muted">
                Plataforma para el registro, seguimiento y gestión
                de solicitudes de soporte técnico.
            </p>

            @if (estaAutenticado)
            {
                <p class="mt-3">
                    Bienvenido,
                    <strong>@Session["UsuarioNombre"]</strong>
                </p>

                <span class="badge bg-primary">
                    @rol
                </span>
            }

        </header>

        @if (!estaAutenticado)
        {
            <div class="card shadow-sm mx-auto" style="max-width: 600px;">

                <div class="card-body text-center p-5">

                    <h4 class="card-title mb-3">
                        Bienvenido al sistema
                    </h4>

                    <p class="card-text text-muted mb-4">
                        Para acceder a las funcionalidades del sistema,
                        debe iniciar sesión con sus credenciales.
                    </p>

                    @Html.ActionLink(
                             "Iniciar sesión",
                             "Login",
                             "Cuenta",
                             null,
                             new { @class = "btn btn-primary btn-lg" }
                         )

                </div>

            </div>
        }
        else if (rol == "Usuario")
        {
            <div class="row g-4">

                <div class="col-md-6">

                    <div class="card shadow-sm h-100">

                        <div class="card-body text-center p-4">

                            <h4 class="card-title mb-3">
                                Crear ticket
                            </h4>

                            <p class="card-text text-muted">
                                Registre una nueva solicitud de soporte
                                técnico para reportar un problema o
                                solicitar asistencia.
                            </p>

                            @Html.ActionLink(
                                     "Crear solicitud",
                                     "Crear",
                                     "Ticket",
                                     null,
                                     new { @class = "btn btn-primary" }
                                 )

                        </div>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="card shadow-sm h-100">

                        <div class="card-body text-center p-4">

                            <h4 class="card-title mb-3">
                                Mis tickets
                            </h4>

                            <p class="card-text text-muted">
                                Consulte sus solicitudes, revise su estado
                                y acceda al detalle para dar seguimiento
                                mediante comentarios.
                            </p>

                            @Html.ActionLink(
                                     "Consultar tickets",
                                     "Index",
                                     "Ticket",
                                     null,
                                     new { @class = "btn btn-outline-primary" }
                                 )

                        </div>

                    </div>

                </div>


            </div>
        }
        else if (rol == "Administrador")
        {
            <!-- Opciones del administrador -->
    <div class="row g-4">

        <div class="col-md-6">

            <div class="card shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <h4 class="card-title mb-3">
                        Gestión de tickets
                    </h4>

                    <p class="card-text text-muted">
                        Consulte todas las solicitudes registradas,
                        revise sus detalles, asigne responsables
                        y actualice sus estados.
                    </p>

                    @Html.ActionLink(
                                  "Administrar tickets",
                                  "Index",
                                  "Ticket",
                                  null,
                                  new { @class = "btn btn-primary" }
                              )

                </div>

            </div>

        </div>

        <div class="col-md-6">

            <div class="card shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <h4 class="card-title mb-3">
                        Registrar ticket
                    </h4>

                    <p class="card-text text-muted">
                        Registre una nueva solicitud de soporte
                        técnico en el sistema.
                    </p>

                    @Html.ActionLink(
                                  "Crear ticket",
                                  "Crear",
                                  "Ticket",
                                  null,
                                  new { @class = "btn btn-outline-primary" }
                              )

                </div>

            </div>

        </div>

        <div class="col-md-12">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center p-4">

                    <h4 class="card-title">Reportes</h4>

                    <p class="card-text text-muted">
                        Consulta la cantidad de tickets registrados
                        según su estado actual.
                    </p>

                    @Html.ActionLink(
                             "Consultar reportes",
                             "Index",
                             "Reporte",
                             null,
                             new { @class = "btn btn-primary" }
                         )

                </div>
            </div>
        </div>


    </div>
        }
        else
        {
            <div class="alert alert-warning text-center" role="alert">
                No se pudo identificar su rol de usuario.
                Comuníquese con el administrador del sistema.
            </div>
        }

    </section>

</main>
