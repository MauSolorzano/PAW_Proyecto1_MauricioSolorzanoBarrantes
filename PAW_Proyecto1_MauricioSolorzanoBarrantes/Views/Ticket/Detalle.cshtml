
@model PAW_Proyecto1_MauricioSolorzanoBarrantes.Models.Ticket

@{
    ViewBag.Title = "Detalle del ticket";
}

<main class="container">

    <section class="mt-4">

        <header class="mb-4">
            <h2>Detalle del ticket #@Model.Id</h2>
            <p class="text-muted">
                Consulta la información y los comentarios relacionados con este ticket.
            </p>
        </header>

        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <h5 class="mb-0">Información del ticket</h5>
            </div>

            <div class="card-body">

                <div class="mb-3">
                    <strong>Título:</strong>
                    <p>@Model.Titulo</p>
                </div>

                <div class="mb-3">
                    <strong>Descripción:</strong>
                    <p>@Model.Descripcion</p>
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <strong>Categoría:</strong>
                        <p>@Model.Categoria</p>
                    </div>

                    <div class="col-md-6 mb-3">
                        <strong>Estado:</strong>
                        <p>@Model.NombreEstado</p>
                    </div>

                </div>

                <div>
                    <strong>Fecha de creación:</strong>
                    <p>@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</p>
                </div>

            </div>

        </div>

        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <h5 class="mb-0">Comentarios</h5>
            </div>

            <div class="card-body">

                <div id="listaComentarios">
                    <p class="text-muted mb-0">Cargando comentarios...</p>
                </div>

            </div>

        </div>

        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <h5 class="mb-0">Agregar comentario</h5>
            </div>

            <div class="card-body">

                <form id="formComentario">

                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="textoComentario" class="form-label">
                            Escriba su comentario
                        </label>

                        <textarea id="textoComentario"
                                  class="form-control"
                                  rows="4"
                                  maxlength="2000"
                                  placeholder="Escriba su comentario..."
                                  required></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        Enviar comentario
                    </button>

                </form>

                <div id="mensajeComentario" class="mt-3"></div>

            </div>

        </div>

        <div class="mb-4">
            @Html.ActionLink(
                               "Volver a mis tickets",
                               "Index",
                               "Ticket",
                               null,
                               new { @class = "btn btn-outline-secondary" }
                           )
        </div>

    </section>
    <input type="hidden" id="idTicket" value="@Model.Id" />
</main>

@section scripts {
    <script>
        $(document).ready(function () {

            var idTicket = parseInt($("#idTicket").val());
            // Consultar comentarios
            function cargarComentarios() {

                $.ajax({
                    url: '@Url.Action("Obtener", "Comentario")',
                    type: 'GET',
                    data: { idTicket: idTicket },

                    success: function (comentarios) {

                        $("#listaComentarios").empty();

                        if (comentarios.length === 0) {
                            $("#listaComentarios").text(
                                "Todavía no hay comentarios."
                            );
                            return;
                        }

                        $.each(comentarios, function (i, comentario) {

                            var fecha = new Date(
                                parseInt(
                                    comentario.Fecha.replace(
                                        /\/Date\((\d+)\)\//, "$1"
                                    )
                                )
                            );

                            var texto = $("<p>").text(comentario.Texto);
                            var nombre = $("<strong>").text(
                                comentario.NombreUsuario
                            );

                            var fechaTexto = fecha.toLocaleString("es-CR");

                            var contenedor = $("<div>");
                            contenedor.append(nombre);
                            contenedor.append(" - " + fechaTexto);
                            contenedor.append(texto);
                            contenedor.append("<hr />");

                            $("#listaComentarios").append(contenedor);
                        });
                    },

                    error: function () {
                        $("#listaComentarios").text(
                            "No se pudieron cargar los comentarios."
                        );
                    }
                });
            }

            // Registrar comentario
            $("#formComentario").submit(function (e) {

                e.preventDefault();

                var texto = $("#textoComentario").val().trim();

                if (texto === "") {
                    $("#mensajeComentario")
                        .removeClass("alert alert-success")
                        .addClass("alert alert-danger")
                        .text("Escriba un comentario.");
                    return;
                }

                $.ajax({
                    url: '@Url.Action("Crear", "Comentario")',
                    type: 'POST',
                    data: {
                        idTicket: idTicket,
                        texto: texto,
                        __RequestVerificationToken:
                            $('input[name="__RequestVerificationToken"]').val()
                    },

                    success: function (respuesta) {

                        $("#mensajeComentario")
                            .removeClass("alert alert-danger alert-success")
                            .addClass(respuesta.ok ? "alert alert-success" : "alert alert-danger")
                            .text(respuesta.mensaje);

                        if (respuesta.ok) {
                            $("#textoComentario").val("");
                            cargarComentarios();
                        }
                    },

                    error: function () {
                        $("#mensajeComentario")
                            .removeClass("alert alert-success")
                            .addClass("alert alert-danger")
                            .text("Ocurrió un error al enviar el comentario.");
                    }
                });
            });

            // Cargar comentarios al abrir la página
            cargarComentarios();

        });
    </script>
}
